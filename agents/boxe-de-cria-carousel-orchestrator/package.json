{
  "name": "@boxe-de-cria/carousel-orchestrator",
  "version": "7.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli.ts validate",
    "build:fixture": "tsx src/cli.ts compile examples/biomechanics-jab.plan.json dist/fixture",
    "ci": "npm run typecheck && npm test && npm run validate && npm run check:repo",
    "check:repo": "node scripts/check-repo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}