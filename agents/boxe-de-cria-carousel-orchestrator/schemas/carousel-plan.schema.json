{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDC Carousel Plan v7.1",
  "type": "object",
  "required": [
    "topic",
    "mode",
    "slide_count",
    "forensic_tier",
    "target_model",
    "claims",
    "sources",
    "slides",
    "caption_required"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "CAROUSEL_PRODUCTION",
        "AUDIENCE_RADAR",
        "TOPIC_AUDIT",
        "REFERENCE_FORENSICS",
        "RENDER_PACK",
        "CAPTION_ONLY",
        "SYSTEM_AUDIT"
      ]
    },
    "slide_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "forensic_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "target_model": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "caption_required": {
      "type": "boolean",
      "const": true
    },
    "final_gate": {
      "enum": [
        "APROVADO",
        "APROVADO_COM_RESSALVAS",
        "REPROVADO"
      ]
    }
  },
  "additionalProperties": true
}