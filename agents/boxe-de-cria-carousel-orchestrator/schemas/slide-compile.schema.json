{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDC Slide Compile Spec v7.1",
  "type": "object",
  "required": [
    "slide_index",
    "slide_count",
    "slide_job",
    "claim_ids",
    "visual_grammar",
    "visual_proof_class",
    "visual_proof",
    "data_state",
    "text_tiers",
    "audience",
    "jtbd",
    "hero",
    "series",
    "mode",
    "criago",
    "source_ids",
    "rejection_conditions"
  ],
  "properties": {
    "slide_index": {
      "type": "integer",
      "minimum": 1
    },
    "slide_count": {
      "type": "integer",
      "minimum": 1
    },
    "slide_job": {
      "type": "string"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "visual_grammar": {
      "type": "string"
    },
    "visual_proof_class": {
      "enum": [
        "DIRECT_PHYSICAL",
        "DOCUMENTARY",
        "MECHANISTIC",
        "COMPARATIVE",
        "CONCEPTUAL",
        "DATA"
      ]
    },
    "visual_proof": {
      "type": "string"
    },
    "data_state": {
      "enum": [
        "CONFIRMED",
        "ESTIMATED",
        "INDIRECT",
        "DIDACTIC_MODEL",
        "NOT_INVESTIGATED",
        "CONFLICTING"
      ]
    },
    "text_tiers": {
      "type": "object",
      "required": [
        "T0",
        "T1",
        "T2"
      ],
      "properties": {
        "T0": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "T1": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "T2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "audience": {
      "type": "string"
    },
    "jtbd": {
      "type": "string"
    },
    "hero": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "criago": {
      "type": "object",
      "required": [
        "role",
        "humor",
        "visibility"
      ],
      "properties": {
        "role": {
          "enum": [
            "CR0",
            "CR1",
            "CR2",
            "CR3",
            "CR4"
          ]
        },
        "humor": {
          "enum": [
            "H0",
            "H1",
            "H2",
            "H3"
          ]
        },
        "visibility": {
          "enum": [
            "ON",
            "OFF"
          ]
        },
        "exact_line": {
          "type": "string"
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejection_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}