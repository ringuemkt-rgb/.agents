      "requires": ["repository-guardian"],
      "forbidden": [
        "invent-source-or-data",
        "invent-trend-or-search-volume",
        "count-duplicate-publications-as-independent-studies",
        "sum-overlapping-samples-as-independent",
        "hide-material-heterogeneity",
        "treat-mechanism-as-clinical-proof",
        "select-hook-before-editorial-claim-lock",
        "copy-third-party-visual-identity",
        "promise-virality",
        "target-vulnerable-person-with-humor",
        "render-images-without-explicit-request"
