{
  "schema_version": 1,
  "workflows": [
    {
      "id": "build-game",
      "description": "Plan and execute a playable game increment with canon, combat, art and QA gates.",
      "steps": [
        {
          "id": "audit",
          "agent": "repository-guardian",
          "deliverables": [
            "repository inventory",
            "reuse report",
            "risk list"
          ]
        },
        {
          "id": "specify",
          "agent": "product-architect",
          "needs": [
            "audit"
          ],
          "deliverables": [
            "scope",
            "acceptance criteria",
            "milestone plan"
          ]
        },
        {
          "id": "canon",
          "agent": "lore-guardian",
          "needs": [
            "specify"
          ],
          "deliverables": [
            "canon constraints",
            "continuity report"
          ]
        },
        {
          "id": "combat",
          "agent": "bjj-combat-engineer",
          "needs": [
            "specify",
            "canon"
          ],
          "deliverables": [
            "combat states",
            "technique contracts",
            "balance assumptions"
          ]
        },
        {
          "id": "implementation",
          "agent": "game-studio-director",
          "needs": [
            "combat"
          ],
          "deliverables": [
            "working vertical slice",
            "data changes",
            "test evidence"
          ]
        },
        {
          "id": "assets",
          "agent": "art-sprite-director",
          "needs": [
            "canon",
            "implementation"
          ],
          "deliverables": [
            "asset manifest",
            "engine-ready assets",
            "visual QA"
          ]
        },
        {
          "id": "security",
          "agent": "security-privacy-guardian",
          "needs": [
            "implementation"
          ],
          "deliverables": [
            "security review",
            "secret and permission findings"
          ]
        },
        {
          "id": "release-gate",
          "agent": "qa-release-guardian",
          "needs": [
            "assets",
            "security"
          ],
          "deliverables": [
            "test report",
            "build evidence",
            "release decision"
          ]
        }
      ]
    },
    {
      "id": "consolidate-repository",
      "description": "Safely absorb useful work into one official repository and retire duplicates.",
      "steps": [
        {
          "id": "inventory",
          "agent": "repository-guardian",
          "deliverables": [
            "repository matrix",
            "unique-file inventory"
          ]
        },
        {
          "id": "decide",
          "agent": "product-architect",
          "needs": [
            "inventory"
          ],
          "deliverables": [
            "canonical architecture",
            "migration decisions"
          ]
        },
        {
          "id": "privacy-check",
          "agent": "security-privacy-guardian",
          "needs": [
            "inventory"
          ],
          "deliverables": [
            "secret review",
            "sensitive-data report"
          ]
        },
        {
          "id": "migrate",
          "agent": "repository-guardian",
          "needs": [
            "decide",
            "privacy-check"
          ],
          "deliverables": [
            "migration commit",
            "deletion list"
          ]
        },
        {
          "id": "verify",
          "agent": "qa-release-guardian",
          "needs": [
            "migrate"
          ],
          "deliverables": [
            "validation report",
            "retirement approval"
          ]
        }
      ]
    },
    {
      "id": "create-game-assets",
      "description": "Produce original sprites and maps with canon and engine-handoff validation.",
      "steps": [
        {
          "id": "asset-brief",
          "agent": "product-architect",
          "deliverables": [
            "asset list",
            "technical dimensions",
            "acceptance criteria"
          ]
        },
        {
          "id": "canon-check",
          "agent": "lore-guardian",
          "needs": [
            "asset-brief"
          ],
          "deliverables": [
            "visual canon constraints"
          ]
        },
        {
          "id": "generate",
          "agent": "art-sprite-director",
          "needs": [
            "canon-check"
          ],
          "deliverables": [
            "transparent sprites",
            "manifests",
            "preview animations"
          ]
        },
        {
          "id": "engine-check",
          "agent": "game-studio-director",
          "needs": [
            "generate"
          ],
          "deliverables": [
            "Godot import",
            "scene integration"
          ]
        },
        {
          "id": "qa",
          "agent": "qa-release-guardian",
          "needs": [
            "engine-check"
          ],
          "deliverables": [
            "frame QA",
            "runtime validation"
          ]
        }
      ]
    },
    {
      "id": "release-mobile",
      "description": "Prepare and validate an Android release without claiming success before evidence exists.",
      "steps": [
        {
          "id": "preflight",
          "agent": "repository-guardian",
          "deliverables": [
            "clean working tree",
            "version report"
          ]
        },
        {
          "id": "security",
          "agent": "security-privacy-guardian",
          "needs": [
            "preflight"
          ],
          "deliverables": [
            "permission review",
            "credential review"
          ]
        },
        {
          "id": "build",
          "agent": "game-studio-director",
          "needs": [
            "security"
          ],
          "deliverables": [
            "build artifact",
            "build logs"
          ]
        },
        {
          "id": "release-gate",
          "agent": "qa-release-guardian",
          "needs": [
            "build"
          ],
          "deliverables": [
            "installation test",
            "smoke test",
            "release decision"
          ]
        }
      ]
    },
    {
      "id": "build-bdc-carousel",
      "description": "Turn an audience question, pain, demand signal or user-defined topic into a prioritized, adversarially investigated, evidence-synthesized, perceptually optimized and Gemini-ready autonomous 2.5D carousel package.",
      "steps": [
        {
          "id": "repository-check",
          "agent": "repository-guardian",
          "deliverables": [
            "instruction source confirmed",
            "portable agent version confirmed as 7.0.0-portable.1",
            "investigative engine confirmed",
            "25-block prompt protocol confirmed",
            "2.5D render lock confirmed",
            "accessibility lock confirmed",
            "official logo lock confirmed",
            "portable SKILL.md contract confirmed",
            "orchestrator architecture map confirmed",
            "autonomy repetition law confirmed",
            "audience demand engine confirmed",
            "topic opportunity engine confirmed",
            "content graph engine confirmed",
            "Gemini production adapter confirmed",
            "prompt compiler confirmed",
            "neuromarketing perception engine confirmed"
          ]
        },
        {
          "id": "carousel",
          "agent": "boxe-de-cria-carousel-orchestrator",
          "needs": [
            "repository-check"
          ],
          "deliverables": [
            "audience and problem fit",
            "question decomposition",
            "forensic tier decision",
            "rival hypothesis set",
            "search completeness status",
            "evidence inventory and finding atoms when material",
            "study-family and overlap resolution",
            "source reliability and information credibility assessment",
            "outcome ontology and exposure decomposition",
            "risk-of-bias reasoning",
            "effect normalization",
            "replication independence and researcher-network analysis when material",
            "ACH matrix when material",
            "evidence graph",
            "causal DAG when material",
            "alternative explanations and counterfactual tests",
            "moderator dose and temporal analysis when material",
            "cross-method triangulation",
            "contradiction resolution",
            "negative-evidence and missing-evidence passes",
            "sensitivity analysis",
            "applicability and certainty by outcome",
            "benefit harm burden analysis",
            "investigator bias guard",
            "falsification gate",
            "best current explanation",
            "evidence gap map",
            "editorial claim lock",
            "viral brief and hook winner",
            "slide architecture and retention map",
            "palette decision and accessibility validation",
            "autonomous 25-block 2.5D prompts",
            "copy-paste caption",
            "sources",
            "guardian decision",
            "full frame and background lock repeated per slide",
            "full Criago canonical lock repeated per slide including visibility off",
            "no cross-slide shorthand dependencies",
            "audience persona and raw-query language when material",
            "search intent classification",
            "pain desire and jobs-to-be-done map",
            "demand level D0-D4 and freshness F0-F3 when material",
            "competitor gap and BDC expertise moat",
            "topic opportunity class and why-now rationale",
            "content graph and next-node map",
            "Gemini Image adapter when targeted",
            "T0 T1 T2 exact-text priority for Gemini",
            "one-slide-per-generation Gemini plan",
            "Gemini post-render QA before next slide"
          ]
        }
      ]
    },
    {
      "id": "build-bdc-audience-radar",
      "description": "Map real audience questions, pains, intent, demand signals, content gaps and BDC topic opportunities without generating carousel prompts unless explicitly requested.",
      "steps": [
        {
          "id": "repository-check",
          "agent": "repository-guardian",
          "deliverables": [
            "v7.0 module authority confirmed",
            "audience demand engine confirmed",
            "topic opportunity engine confirmed",
            "content graph engine confirmed"
          ]
        },
        {
          "id": "audience-radar",
          "agent": "boxe-de-cria-carousel-orchestrator",
          "needs": [
            "repository-check"
          ],
          "deliverables": [
            "persona map",
            "raw query families when source data exists",
            "search intent map",
            "pain and desire ontology",
            "jobs-to-be-done map",
            "audience lexicon",
            "demand level D0-D4 without invented volume",
            "freshness F0-F3",
            "independent surface count when known",
            "competitor gaps",
            "BDC expertise moat",
            "question coverage matrix",
            "topic opportunity P0-P3-HOLD",
            "content graph",
            "prioritized topic radar",
            "why-now rationale",
            "evidence feasibility flags"
          ]
        }
      ]
    },
    {
      "id": "run-academic-mission",
      "description": "Run a long-horizon academic mission from call audit through admission, scholarship, relocation and lab integration with evidence and integrity gates.",
      "steps": [
        {
          "id": "repository-check",
          "agent": "repository-guardian",
          "deliverables": [
            "canonical agent package confirmed",
            "public/private boundary confirmed"
          ]
        },
        {
          "id": "mission-control",
          "agent": "academic-mission-orchestrator",
          "needs": [
            "repository-check"
          ],
          "deliverables": [
            "mission state",
            "call matrix",
            "evidence ledger",
            "document audit",
            "barema model",
            "research proposal audit",
            "academic integrity decision",
            "scholarship state",
            "financial transition plan",
            "relocation state",
            "next highest-leverage action"
          ]
        },
        {
          "id": "privacy-gate",
          "agent": "security-privacy-guardian",
          "needs": [
            "mission-control"
          ],
          "deliverables": [
            "PII review",
            "secret review",
            "public/private publication decision"
          ]
        }
      ]
    },
    {
      "id": "build-bdc-media-revenue",
      "description": "Develop evidence-first BOXE DE CRIA news, Brazilian fighter directory and legitimate monetization with human publication gates.",
      "steps": [
        {
          "id": "audit",
          "agent": "repository-guardian",
          "deliverables": [
            "repo inventory",
            "existing Lovable/GitHub status",
            "risks"
          ]
        },
        {
          "id": "plan",
          "agent": "product-architect",
          "needs": [
            "audit"
          ],
          "deliverables": [
            "scoped feature spec",
            "acceptance criteria",
            "financial assumptions"
          ]
        },
        {
          "id": "build",
          "agent": "boxe-de-cria-media-revenue",
          "needs": [
            "plan"
          ],
          "deliverables": [
            "tested data/editorial implementation",
            "audit logs",
            "revenue model"
          ]
        },
        {
          "id": "security",
          "agent": "security-privacy-guardian",
          "needs": [
            "build"
          ],
          "deliverables": [
            "privacy and safety review",
            "adsense compliance checks"
          ]
        },
        {
          "id": "release-gate",
          "agent": "qa-release-guardian",
          "needs": [
            "build",
            "security"
          ],
          "deliverables": [
            "actual tests",
            "go/no-go and blockers"
          ]
        }
      ]
    },
    {
      "id": "build-bdc-visual-assets",
      "description": "Design and validate BOXE DE CRIA news, athletes, events and FISIOBOXE visual assets with immutable brand, provenanced imagery, factual review, responsive exports and release gate.",
      "steps": [
        {
          "id": "audit",
          "agent": "repository-guardian",
          "deliverables": [
            "canonical identity and asset inventory",
            "Lovable state",
            "reuse and risks"
          ]
        },
        {
          "id": "editorial",
          "agent": "boxe-de-cria-media-revenue",
          "needs": [
            "audit"
          ],
          "deliverables": [
            "verified claim brief",
            "approved sources and rights",
            "format requirements"
          ]
        },
        {
          "id": "visual-system",
          "agent": "boxe-de-cria-visual-studio",
          "needs": [
            "editorial"
          ],
          "deliverables": [
            "visual brief",
            "brand tokens and master asset provenance",
            "responsive layout/templates",
            "visual QA"
          ]
        },
        {
          "id": "privacy",
          "agent": "security-privacy-guardian",
          "needs": [
            "visual-system"
          ],
          "deliverables": [
            "photo/license/minor privacy review",
            "publisher safety findings"
          ]
        },
        {
          "id": "release-gate",
          "agent": "qa-release-guardian",
          "needs": [
            "visual-system",
            "privacy"
          ],
          "deliverables": [
            "real test report",
            "fidelity and contrast validation",
            "publishability decision"
          ]
        }
      ]
    },
    {
      "id": "run-satoshi-growth-os",
      "description": "Audit public class facts, prepare a sports marketing brief, verify claims and require human publication approval.",
      "steps": [
        {
          "id": "audit",
          "agent": "repository-guardian",
          "deliverables": [
            "canonical agent location",
            "source inventory"
          ]
        },
        {
          "id": "privacy",
          "agent": "security-privacy-guardian",
          "needs": [
            "audit"
          ],
          "deliverables": [
            "no PII or licensed assets in public scope"
          ]
        },
        {
          "id": "marketing",
          "agent": "satoshi-cria-growth-os",
          "needs": [
            "privacy"
          ],
          "deliverables": [
            "validated briefing",
            "conversion target",
            "CTA and factual status"
          ]
        },
        {
          "id": "final-review",
          "agent": "qa-release-guardian",
          "needs": [
            "marketing"
          ],
          "deliverables": [
            "real test results",
            "human approval gate"
          ]
        }
      ]
    }
  ]
}
