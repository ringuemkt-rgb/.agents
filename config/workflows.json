{
  "schema_version": 1,
  "workflows": [
    {
      "id": "build-game",
      "description": "Plan and execute a playable game increment with canon, combat, art and QA gates.",
      "steps": [
        {"id": "audit", "agent": "repository-guardian", "deliverables": ["repository inventory", "reuse report", "risk list"]},
        {"id": "specify", "agent": "product-architect", "needs": ["audit"], "deliverables": ["scope", "acceptance criteria", "milestone plan"]},
        {"id": "canon", "agent": "lore-guardian", "needs": ["specify"], "deliverables": ["canon constraints", "continuity report"]},
        {"id": "combat", "agent": "bjj-combat-engineer", "needs": ["specify", "canon"], "deliverables": ["combat states", "technique contracts", "balance assumptions"]},
        {"id": "implementation", "agent": "game-studio-director", "needs": ["combat"], "deliverables": ["working vertical slice", "data changes", "test evidence"]},
        {"id": "assets", "agent": "art-sprite-director", "needs": ["canon", "implementation"], "deliverables": ["asset manifest", "engine-ready assets", "visual QA"]},
        {"id": "security", "agent": "security-privacy-guardian", "needs": ["implementation"], "deliverables": ["security review", "secret and permission findings"]},
        {"id": "release-gate", "agent": "qa-release-guardian", "needs": ["assets", "security"], "deliverables": ["test report", "build evidence", "release decision"]}
      ]
    },
    {
      "id": "consolidate-repository",
      "description": "Safely absorb useful work into one official repository and retire duplicates.",
      "steps": [
        {"id": "inventory", "agent": "repository-guardian", "deliverables": ["repository matrix", "unique-file inventory"]},
        {"id": "decide", "agent": "product-architect", "needs": ["inventory"], "deliverables": ["canonical architecture", "migration decisions"]},
        {"id": "privacy-check", "agent": "security-privacy-guardian", "needs": ["inventory"], "deliverables": ["secret review", "sensitive-data report"]},
        {"id": "migrate", "agent": "repository-guardian", "needs": ["decide", "privacy-check"], "deliverables": ["migration commit", "deletion list"]},
        {"id": "verify", "agent": "qa-release-guardian", "needs": ["migrate"], "deliverables": ["validation report", "retirement approval"]}
      ]
    },
    {
      "id": "create-game-assets",
      "description": "Produce original sprites and maps with canon and engine-handoff validation.",
      "steps": [
        {"id": "asset-brief", "agent": "product-architect", "deliverables": ["asset list", "technical dimensions", "acceptance criteria"]},
        {"id": "canon-check", "agent": "lore-guardian", "needs": ["asset-brief"], "deliverables": ["visual canon constraints"]},
        {"id": "generate", "agent": "art-sprite-director", "needs": ["canon-check"], "deliverables": ["transparent sprites", "manifests", "preview animations"]},
        {"id": "engine-check", "agent": "game-studio-director", "needs": ["generate"], "deliverables": ["Godot import", "scene integration"]},
        {"id": "qa", "agent": "qa-release-guardian", "needs": ["engine-check"], "deliverables": ["frame QA", "runtime validation"]}
      ]
    },
    {
      "id": "release-mobile",
      "description": "Prepare and validate an Android release without claiming success before evidence exists.",
      "steps": [
        {"id": "preflight", "agent": "repository-guardian", "deliverables": ["clean working tree", "version report"]},
        {"id": "security", "agent": "security-privacy-guardian", "needs": ["preflight"], "deliverables": ["permission review", "credential review"]},
        {"id": "build", "agent": "game-studio-director", "needs": ["security"], "deliverables": ["build artifact", "build logs"]},
        {"id": "release-gate", "agent": "qa-release-guardian", "needs": ["build"], "deliverables": ["installation test", "smoke test", "release decision"]}
      ]
    },
    {
      "id": "build-bdc-carousel",
      "description": "Turn a BOXE DE CRIA/FISIOBOXE topic into an adversarially investigated, evidence-synthesized, retention-engineered and 2.5D visually explanatory autonomous carousel prompt package with caption and QA.",
      "steps": [
        {
          "id": "repository-check",
          "agent": "repository-guardian",
          "deliverables": [
            "instruction source confirmed",
            "portable agent version confirmed as 4.2.0-portable.1",
            "investigative engine confirmed",
            "22-block prompt protocol confirmed",
            "2.5D render lock confirmed",
            "accessibility lock confirmed",
            "official logo lock confirmed"
          ]
        },
        {
          "id": "carousel",
          "agent": "boxe-de-cria-carousel-orchestrator",
          "needs": ["repository-check"],
          "deliverables": [
            "audience and problem fit",
            "question decomposition",
            "forensic tier decision",
            "rival hypothesis set",
            "search completeness status",
            "evidence inventory and finding atoms when material",
            "study-family and overlap resolution",
            "source reliability and information credibility assessment",
            "outcome ontology and exposure decomposition",
            "risk-of-bias reasoning",
            "effect normalization",
            "replication independence and researcher-network analysis when material",
            "ACH matrix when material",
            "evidence graph",
            "causal DAG when material",
            "alternative explanations and counterfactual tests",
            "moderator dose and temporal analysis when material",
            "cross-method triangulation",
            "contradiction resolution",
            "negative-evidence and missing-evidence passes",
            "sensitivity analysis",
            "applicability and certainty by outcome",
            "benefit harm burden analysis",
            "investigator bias guard",
            "falsification gate",
            "best current explanation",
            "evidence gap map",
            "editorial claim lock",
            "viral brief and hook winner",
            "slide architecture and retention map",
            "palette decision and accessibility validation",
            "autonomous 22-block 2.5D prompts",
            "copy-paste caption",
            "sources",
            "guardian decision"
          ]
        }
      ]
    }
  ]
}
